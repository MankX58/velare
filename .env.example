# Copia este archivo como .env.local y pega cada valor después del "=", sin comillas.
# .env.local nunca se sube al repositorio.

# Dirección donde corre la app (en producción: https://<proyecto>.vercel.app)
APP_BASE_URL=http://localhost:3000

# Auth0 → Applications → tu aplicación → Settings. AUTH0_DOMAIN va sin "https://".
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Se genera con: openssl rand -hex 32
AUTH0_SECRET=

# Neon → botón Connect. En desarrollo usa SIEMPRE la rama dev.
# DATABASE_URL: con "Connection pooling" activado. DATABASE_URL_UNPOOLED: desactivado.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Opcional. Google Search Console → Añadir propiedad → "Etiqueta HTML": pega solo el
# valor de content="...". Sirve para que Google confirme que el sitio es tuyo. No es un secreto.
GOOGLE_SITE_VERIFICATION=

# Vercel → tu proyecto → Storage → Blob. Sirve para subir fotos de producto desde el panel.
# Sin este valor todo funciona igual, salvo el botón "Subir una foto".
BLOB_READ_WRITE_TOKEN=
