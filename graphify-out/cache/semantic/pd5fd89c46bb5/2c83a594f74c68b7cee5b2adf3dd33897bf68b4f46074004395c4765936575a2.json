{"nodes": [{"id": "design_diseno_de_velare", "label": "Dise\u00f1o de Velare (DESIGN.md)", "file_type": "document", "source_file": "DESIGN.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_vitrina_fria", "label": "Idea: vitrina fr\u00eda y limpia, no un sal\u00f3n dorado", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L5-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se evita crema+serif+dorado y negro+dorado porque es lo que usa toda la categor\u00eda. Un solo tema claro porque las fotos de producto vienen sobre blanco y el panel se usa de d\u00eda."}, {"id": "design_paleta_de_color", "label": "Paleta de color (tokens de globals.css)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L11-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo existen los colores de globals.css; la paleta por defecto de Tailwind est\u00e1 desactivada. Contrastes comprobados uno por uno (texto >= 4,5:1); text-ink-faint no va sobre bg-mist."}, {"id": "design_verde_salvia", "label": "Verde salvia #596357 (\u00fanico color de marca)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L26-L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No se a\u00f1ade un segundo acento; toda la paleta comparte su tono con poca saturaci\u00f3n. Como es oscuro, el texto encima es claro (on-brand)."}, {"id": "design_tipografia", "label": "Tipograf\u00eda: Jost (display) y Geist (sans)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L33-L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tipograf\u00eda de caja de perfume: Jost para t\u00edtulos y marca, Geist para el resto con tabular-nums en tablas. T\u00edtulos en font-light y tracking-tight, sin r\u00f3tulos en may\u00fasculas sobre los t\u00edtulos."}, {"id": "design_wordmark", "label": "Wordmark (componente de la marca escrita)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_lema", "label": "Lema: Fragancias que dejan huella", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_forma", "label": "Forma: esquinas rectas y sin sombras", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L42-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La jerarqu\u00eda se marca con bordes de 1px y espacio. La \u00fanica excepci\u00f3n son los avisos de Sileo, que traen su propia forma."}, {"id": "design_movimiento", "label": "Movimiento: escala de transitions.dev", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L48-L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo se anima lo que comunica algo (cambio de estado, respuesta a una acci\u00f3n, orden de lectura). Toda animaci\u00f3n lleva motion-safe; un escalonado no pasa de 300 ms; cerrar siempre es m\u00e1s r\u00e1pido que abrir."}, {"id": "design_viewtransition_morph", "label": "Elemento compartido lista-producto (ViewTransition morph)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_sileo_avisos", "label": "Avisos con Sileo (Toaster en el layout ra\u00edz)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los errores de formulario van junto al campo, no en un aviso."}, {"id": "design_iconos_phosphor", "label": "Iconos: @phosphor-icons/react en peso light", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_cifras_con_explicacion", "label": "Principio: ninguna cifra va sola en el panel", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L89-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada n\u00famero dice de d\u00f3nde sale (hint) y las columnas se explican sin jerga: 'Ganancia sobre el costo' en vez de 'markup'."}, {"id": "design_avance_de_pedido", "label": "Avance de un pedido: un bot\u00f3n por paso, sin selector de estado", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un pedido avanza con un solo bot\u00f3n por paso ('Qu\u00e9 sigue' en el panel; 'Ya pagu\u00e9' y 'Ya lo recib\u00ed' en la tienda). Cada frase dice a qui\u00e9n le toca actuar, distinta para cliente y panel."}, {"id": "design_confirmar_antes_de_eliminar", "label": "Eliminar siempre con confirmaci\u00f3n (ConfirmButton)", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nunca un borrado de un solo clic."}, {"id": "design_estados_de_pantalla", "label": "Estados de pantalla: carga, vac\u00edo y error", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_panel_y_tienda", "label": "Panel (denso, sin adornos) frente a Tienda (aire, asimetr\u00eda, fotos reales)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L98-L101", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_texto", "label": "Voz del texto: espa\u00f1ol claro, botones que nombran su acci\u00f3n", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "L103-L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin rayas largas ni palabras de relleno ('eleva', 'descubre la experiencia')."}, {"id": "design_accesibilidad", "label": "Accesibilidad y comodidad (reglas de dise\u00f1o)", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "L107-L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Objetivos t\u00e1ctiles de 24/44px; campos a 16px en el tel\u00e9fono porque con menos iOS hace zoom; un solo h1 y contenedor #contenido; las constantes de estilo de un componente de servidor no pueden vivir en un archivo 'use client'; revisar en 320, 768 y 1920 px."}, {"id": "src_app_globals", "label": "src/app/globals.css", "file_type": "code", "source_file": "DESIGN.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_components_logo_mark", "label": "src/components/logo-mark.tsx (LogoMark)", "file_type": "code", "source_file": "DESIGN.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_components_button", "label": "src/components/button.ts (buttonStyles, linkStyles)", "file_type": "code", "source_file": "DESIGN.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_components_store_product_tile", "label": "src/components/store/product-tile.tsx (ProductLabel, ProductCard)", "file_type": "code", "source_file": "DESIGN.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_components_store_gallery", "label": "src/components/store/gallery.tsx (Gallery)", "file_type": "code", "source_fi